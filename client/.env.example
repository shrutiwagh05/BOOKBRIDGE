# BookBridge Frontend Environment Variables

# Backend API Base URL
# - For local development with Vite dev proxy: leave blank or use http://localhost:5000/api
# - For Vercel deployment: set this in Vercel Project Settings > Environment Variables
#   to your deployed backend URL (e.g. https://bookbridge-server.onrender.com/api)
VITE_API_URL=http://localhost:5000/api
