# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your local MongoDB string or MongoDB Atlas connection URI
MONGO_URI=mongodb://127.0.0.1:27017/bookbridge

# JWT Authentication Secret
# Generate a secure random string for production
JWT_SECRET=bookbridge_dev_secret_key_change_in_production_12345
JWT_EXPIRES_IN=7d

# Client URL (for CORS allowed origins)
CLIENT_URL=http://localhost:5173
